{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hopper finished port",
  "type": "object",
  "additionalProperties": false,
  "required": ["fabric", "horizon", "info"],
  "properties": {
    "fabric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modrinth"],
      "properties": {
        "modrinth": { "type": "string", "pattern": "^[a-zA-Z0-9._-]{3,64}$" },
        "versions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "builds"],
      "properties": {
        "registry": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "builds": { "type": "string", "minLength": 1 }
      }
    },
    "info": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ported_by", "tested"],
      "properties": {
        "ported_by": { "type": "string", "minLength": 1 },
        "tested": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "notes": { "type": "string" }
      }
    }
  }
}
